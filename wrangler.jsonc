{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deadlineapp",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "VAPID_PUBLIC_KEY": "BNuyKpLFQyL2wqlTv4OAZC183J9v0Oj51-LnrroSHYXTUXl0efleJP27DvQghDqAPWQA6gkK7lXLX2y8Fx6tW54",
    "VAPID_SUBJECT": "https://deadlineapp.zuiken.workers.dev/"
  },
  "previews": {},
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "fc00c0ddcd4f467a9d93c3ad9c730ebf"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/push/*"]
  }
}
